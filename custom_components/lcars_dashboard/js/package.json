{
  "name": "lcars-dashboard",
  "private": true,
  "version": "5.15.0-beta.4",
  "description": "LCARS Dashboard — Home Assistant Lovelace dashboard with Star Trek LCARS UI. Based on Dwains Dashboard by Dwain Scheeren.",
  "scripts": {
    "build": "npm run lint:selfclose && npm run lint:phi && webpack --mode=production",
    "watch": "webpack --watch --mode=development",
    "lint:selfclose": "node tools/check-svg-selfclose.js",
    "lint:phi": "node tools/check-phi-logging.js"
  },
  "keywords": [
    "lcars",
    "home-assistant",
    "lovelace",
    "dashboard",
    "hacs"
  ],
  "author": "htiel (based on Dwains Dashboard by Dwain Scheeren)",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.2.5",
    "css-loader": "^6.7.2",
    "html-webpack-plugin": "^5.5.1",
    "postcss": "^8.5.14",
    "postcss-cli": "^8.3.1",
    "postcss-loader": "^7.0.2",
    "style-loader": "^3.3.2",
    "tailwindcss": "^2.0.3",
    "webpack": "^5.26.0",
    "webpack-cli": "^4.5.0",
    "webpack-merge": "^5.7.3"
  },
  "dependencies": {
    "@mdi/js": "^6.5.95",
    "card-tools": "github:thomasloven/lovelace-card-tools#477f3d4eeb5c70cab047d418d19afb6b0f07bf49",
    "custom-card-helpers": "^1.8.0",
    "lit-element": "^2.2.1",
    "lit-html": "^1.1.2",
    "sortablejs": "^1.14.0"
  }
}
